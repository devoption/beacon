# PHP security release for CVE-2026-109618 and CVE-2026-109619.
ARG PHP_VERSION=8.4.27

FROM composer:2 AS vendor
WORKDIR /app
COPY composer.json composer.lock* ./
RUN composer install \
    --no-dev \
    --no-interaction \
    --no-scripts \
    --no-progress \
    --prefer-dist

FROM php:${PHP_VERSION}-fpm-alpine AS beacon

# Reject vulnerable overrides as well as vulnerable defaults.
RUN php -r 'exit((PHP_VERSION_ID >= 80336 && PHP_VERSION_ID < 80400) || (PHP_VERSION_ID >= 80427 && PHP_VERSION_ID < 80500) || (PHP_VERSION_ID >= 80512 && PHP_VERSION_ID < 80600) ? 0 : 1);'

WORKDIR /var/www/html

RUN apk add --no-cache \
    fcgi \
    git \
    icu-data-full \
    icu-libs \
    libzip \
    oniguruma-dev \
    zip \
    && docker-php-ext-install \
        bcmath \
        opcache \
        pdo_mysql \
    && rm -rf /var/cache/apk/*

COPY --from=vendor /app/vendor ./vendor
COPY . .

RUN cp .env.example .env 2>/dev/null || true \
    && chown -R www-data:www-data /var/www/html \
    && chmod -R ug+rwx storage bootstrap/cache 2>/dev/null || true

LABEL org.opencontainers.image.title="{{application_name}}"
LABEL io.devoption.beacon.runtime="php-fpm"

EXPOSE 9000

CMD ["php-fpm", "-F"]
